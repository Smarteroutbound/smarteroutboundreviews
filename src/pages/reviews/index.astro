---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import StarRating from "../../components/StarRating.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { formatDate, average } from "../../js/utils.ts";
import {
  getBreadcrumbSchema,
  getAggregateRatingSchema,
  getItemListSchema,
} from "../../js/jsonLD.ts";
import RatingDistribution from "../../components/RatingDistribution.astro";
import TrustBadges from "../../components/TrustBadges.astro";

const allReviews = (await getCollection("reviews")).filter((r) => !r.data.draft);
const sorted = allReviews.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
);

const aggregateRating = sorted.length > 0 ? average(sorted.map((r) => r.data.rating)) : 0;
const reviewCount = sorted.length;

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Reviews" },
];

const jsonLD = [
  getBreadcrumbSchema(breadcrumbItems),
  ...(reviewCount > 0
    ? [
        getAggregateRatingSchema({ ratingValue: aggregateRating, reviewCount }),
        getItemListSchema({
          name: "All SmarterOutbound client reviews",
          description: `${reviewCount} verified client reviews of SmarterOutbound across multiple industries and channels.`,
          items: sorted.map((r) => ({ name: r.data.title, url: `/reviews/${r.id}` })),
        }),
      ]
    : []),
];
---

<MainLayout
  title={`SmarterOutbound Client Reviews — ${reviewCount} Verified, ${aggregateRating.toFixed(1)}/5 Avg`}
  description={`${reviewCount} verified client reviews of SmarterOutbound from B2B SaaS founders, paving and construction contractors, agencies, and professional services firms. Cold email, LinkedIn, SMS, and calling campaigns. Published by SmarterOutbound under a written editorial policy.`}
  jsonLD={jsonLD}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="mb-10 pb-8 border-b border-gray-100">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-3">
        SmarterOutbound Client Reviews — Cold Email, SMS, LinkedIn &amp; Calling
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-5 max-w-2xl">
        {reviewCount} verified reviews from B2B SaaS founders, paving and construction contractors, agencies, and professional services firms. Non-incentivized, with critical reviews published alongside positive ones. <a href="/editorial-policy" class="text-primary-600 hover:text-primary-700 underline">Editorial policy</a> &middot; <a href="/industries" class="text-primary-600 hover:text-primary-700 underline">Browse by industry</a>.
      </p>
      {reviewCount > 0 && (
        <div class="grid md:grid-cols-[auto_1fr] gap-5 items-start">
          <div class="bg-white rounded-xl border border-gray-100 px-5 py-4">
            <div class="flex items-center gap-3 mb-2">
              <StarRating rating={aggregateRating} size="lg" />
              <span class="text-2xl font-bold text-gray-900">{aggregateRating.toFixed(1)}</span>
            </div>
            <div class="text-sm text-gray-500">{reviewCount} {reviewCount === 1 ? "review" : "reviews"} &middot; average</div>
            <a href="/submit-review" class="mt-3 inline-flex items-center gap-1.5 text-primary-600 hover:text-primary-700 font-semibold text-sm no-underline">
              Add your review
              <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 5l5 5-5 5" />
              </svg>
            </a>
          </div>
          <RatingDistribution reviews={sorted} />
        </div>
      )}
      <div class="mt-6">
        <TrustBadges variant="horizontal" />
      </div>
    </header>

    {sorted.length === 0 ? (
      <p class="text-gray-500 italic">No reviews published yet. Check back soon.</p>
    ) : (
      <div class="space-y-5">
        {sorted.map((r) => (
          <a
            href={`/reviews/${r.id}`}
            class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:border-primary-300 hover:shadow-md transition-all no-underline"
          >
            <div class="flex items-center justify-between mb-3 flex-wrap gap-3">
              <StarRating rating={r.data.rating} showValue />
              <time class="text-xs text-gray-400" datetime={r.data.date.toISOString()}>
                {formatDate(r.data.date)}
              </time>
            </div>
            <h2 class="text-xl font-bold text-gray-900 group-hover:text-primary-700 transition-colors mb-2 leading-snug">
              {r.data.title}
            </h2>
            <p class="text-sm text-gray-600 leading-relaxed mb-4">{r.data.summary}</p>

            {(r.data.serviceUsed || r.data.outcome) && (
              <div class="grid sm:grid-cols-2 gap-3 mb-4">
                {r.data.serviceUsed && (
                  <div class="text-xs">
                    <span class="font-semibold text-gray-500 uppercase tracking-wider">Service: </span>
                    <span class="text-gray-700">{r.data.serviceUsed}</span>
                  </div>
                )}
                {r.data.outcome && (
                  <div class="text-xs">
                    <span class="font-semibold text-success-600 uppercase tracking-wider">Outcome: </span>
                    <span class="text-gray-700">{r.data.outcome}</span>
                  </div>
                )}
              </div>
            )}

            <div class="flex items-center gap-2 text-xs text-gray-500 pt-3 border-t border-gray-100">
              <div class="w-6 h-6 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-bold text-xs">
                {r.data.reviewer.charAt(0)}
              </div>
              <span class="font-medium text-gray-700">{r.data.reviewer}</span>
              {r.data.reviewerTitle && <span class="text-gray-400">&middot; {r.data.reviewerTitle}</span>}
              {r.data.reviewerCompany && <span class="text-gray-400">&middot; {r.data.reviewerCompany}</span>}
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</MainLayout>
