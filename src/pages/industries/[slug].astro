---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import StarRating from "../../components/StarRating.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import { formatDate, average } from "../../js/utils.ts";
import {
  getBreadcrumbSchema,
  getItemListSchema,
  getAggregateRatingSchema,
} from "../../js/jsonLD.ts";
import { industries } from "../../data/industries.ts";

export async function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

const { industry } = Astro.props;

const allReviews = (await getCollection("reviews")).filter((r) => !r.data.draft);
const allComparisons = (await getCollection("comparisons")).filter((c) => !c.data.draft);

// Filter reviews whose tags overlap with this industry's tagFilters
const filterSet = new Set(industry.tagFilters.map((t) => t.toLowerCase()));
const matchedReviews = allReviews.filter((r) => {
  const reviewTags = new Set((r.data.tags || []).map((t: string) => t.toLowerCase()));
  return [...filterSet].some((t) => reviewTags.has(t));
});

// Sort: featured slugs first, then newest
const featuredSet = new Set(industry.featuredReviewSlugs || []);
const sortedReviews = matchedReviews.sort((a, b) => {
  const aFeatured = featuredSet.has(a.id) ? 1 : 0;
  const bFeatured = featuredSet.has(b.id) ? 1 : 0;
  if (aFeatured !== bFeatured) return bFeatured - aFeatured;
  return +new Date(b.data.date) - +new Date(a.data.date);
});

const reviewCount = sortedReviews.length;
const aggregateRating = reviewCount > 0 ? average(sortedReviews.map((r) => r.data.rating)) : 0;

// Related comparisons
const relatedComps = (industry.relatedComparisonSlugs || [])
  .map((slug) => allComparisons.find((c) => c.id === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c));

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Industries", url: "/industries" },
  { name: industry.name },
];

const jsonLD: any[] = [
  getBreadcrumbSchema(breadcrumbItems),
  getItemListSchema({
    name: `SmarterOutbound reviews from ${industry.name}`,
    description: industry.metaDescription,
    items: sortedReviews.map((r) => ({ name: r.data.title, url: `/reviews/${r.id}` })),
  }),
];
if (reviewCount > 0) {
  jsonLD.push(getAggregateRatingSchema({ ratingValue: aggregateRating, reviewCount }));
}
---

<MainLayout
  title={industry.metaTitle}
  description={industry.metaDescription}
  jsonLD={jsonLD}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="mb-10 pb-8 border-b border-gray-100">
      <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-700 mb-4">
        Industry hub &middot; {industry.shortName}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-3">
        {industry.h1}
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-5">{industry.intro}</p>

      {reviewCount > 0 && (
        <div class="inline-flex items-center gap-3 bg-white rounded-xl border border-gray-100 px-4 py-2">
          <StarRating rating={aggregateRating} size="md" />
          <span class="font-bold text-gray-900">{aggregateRating.toFixed(1)}</span>
          <span class="text-sm text-gray-500">&middot; {reviewCount} {reviewCount === 1 ? "review" : "reviews"} in this industry</span>
        </div>
      )}
    </header>

    <!-- Channel focus + best for cards -->
    <section class="grid md:grid-cols-2 gap-4 mb-10">
      <div class="bg-primary-50 border border-primary-200 rounded-xl p-5">
        <div class="text-xs uppercase tracking-wider font-bold text-primary-700 mb-1.5">Channel focus for this industry</div>
        <p class="text-sm text-gray-800 leading-relaxed">{industry.channelFocus}</p>
      </div>
      <div class="bg-success-50 border border-success-500/20 rounded-xl p-5">
        <div class="text-xs uppercase tracking-wider font-bold text-success-600 mb-1.5">Best fit for</div>
        <p class="text-sm text-gray-800 leading-relaxed">{industry.bestFor}</p>
      </div>
    </section>

    <!-- Reviews list -->
    {reviewCount === 0 ? (
      <p class="text-gray-500 italic">No reviews tagged for this industry yet. <a href="/reviews" class="text-primary-600 underline">Browse all reviews →</a></p>
    ) : (
      <>
        <h2 class="text-2xl font-bold text-gray-900 mb-5">Reviews from {industry.name.toLowerCase()}</h2>
        <div class="space-y-5">
          {sortedReviews.map((r) => (
            <a
              href={`/reviews/${r.id}`}
              class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:border-primary-300 hover:shadow-md transition-all no-underline"
            >
              <div class="flex items-center justify-between mb-3 flex-wrap gap-3">
                <StarRating rating={r.data.rating} showValue />
                <time class="text-xs text-gray-400" datetime={r.data.date.toISOString()}>
                  {formatDate(r.data.date)}
                </time>
              </div>
              <h3 class="text-lg font-bold text-gray-900 group-hover:text-primary-700 transition-colors mb-2 leading-snug">
                {r.data.title}
              </h3>
              <p class="text-sm text-gray-600 leading-relaxed mb-4">{r.data.summary}</p>
              <div class="flex items-center gap-2 text-xs text-gray-500 pt-3 border-t border-gray-100">
                <div class="w-6 h-6 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-bold text-xs">
                  {r.data.reviewer.charAt(0)}
                </div>
                <span class="font-medium text-gray-700">{r.data.reviewer}</span>
                {r.data.reviewerCompany && <span class="text-gray-400">&middot; {r.data.reviewerCompany}</span>}
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    <!-- Related comparisons -->
    {relatedComps.length > 0 && (
      <section class="mt-14 pt-10 border-t border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Comparisons relevant to {industry.name.toLowerCase()}</h2>
        <p class="text-sm text-gray-500 mb-6">Trying to decide between SmarterOutbound and an alternative? These comparisons cover the trade-offs that matter for this buyer.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedComps.map((c) => (
            <a
              href={`/vs/${c.id}`}
              class="group block bg-white border border-gray-200 rounded-xl p-5 hover:border-primary-300 hover:shadow-sm transition-all no-underline"
            >
              <div class="text-xs font-semibold uppercase tracking-wider text-primary-600 mb-2">
                vs {c.data.competitor}
              </div>
              <h3 class="text-base font-bold text-gray-900 group-hover:text-primary-700 transition-colors leading-snug">
                {c.data.title}
              </h3>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Cross-link to other industries -->
    <section class="mt-14 pt-10 border-t border-gray-100">
      <h2 class="text-xl font-bold text-gray-900 mb-4">Browse other industries</h2>
      <div class="flex flex-wrap gap-2">
        {industries
          .filter((i) => i.slug !== industry.slug)
          .sort((a, b) => a.sortOrder - b.sortOrder)
          .map((i) => (
            <a
              href={`/industries/${i.slug}`}
              class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-gray-100 hover:bg-primary-50 text-sm text-gray-700 hover:text-primary-700 font-medium transition-colors no-underline"
            >
              {i.shortName}
            </a>
          ))}
      </div>
    </section>

    <CtaBlock variant="boxed" />
  </div>
</MainLayout>
