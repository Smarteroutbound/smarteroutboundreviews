---
const { reviews } = Astro.props as { reviews: { data: { rating: number } }[] };

const total = reviews.length;
const counts: Record<number, number> = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
for (const r of reviews) {
  const v = Math.round(r.data.rating);
  if (counts[v] !== undefined) counts[v]++;
}

function pct(n: number) {
  if (total === 0) return 0;
  return Math.round((n / total) * 100);
}
---

<div class="bg-white border border-gray-200 rounded-xl p-5">
  <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-3">Rating distribution</div>
  <div class="space-y-2">
    {[5, 4, 3, 2, 1].map((star) => (
      <div class="flex items-center gap-3">
        <span class="text-xs font-semibold text-gray-700 w-8 shrink-0 flex items-center gap-1">
          {star}
          <svg class="w-3 h-3 text-amber-400" viewBox="0 0 20 20" fill="currentColor"><path d="M10 15.27 16.18 19l-1.64-7.03L20 7.24l-7.19-.61L10 0 7.19 6.63 0 7.24l5.46 4.73L3.82 19z" /></svg>
        </span>
        <div class="flex-1 h-2 bg-gray-100 rounded-full overflow-hidden">
          <div
            class="h-full bg-amber-400 rounded-full transition-all"
            style={`width: ${pct(counts[star])}%`}
          />
        </div>
        <span class="text-xs text-gray-500 w-10 text-right tabular-nums">
          {counts[star]}
        </span>
      </div>
    ))}
  </div>
</div>
