---
import { getCollection } from "astro:content";
import MainLayout from "./MainLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import StarRating from "../components/StarRating.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { formatDate, getReadingTime } from "../js/utils.ts";
import { getComparisonSchema, getBreadcrumbSchema, getFAQSchema } from "../js/jsonLD.ts";
import { industries } from "../data/industries.ts";

function industryUrlForTag(tag: string): string | null {
  const lower = tag.toLowerCase();
  const match = industries.find((i) => i.tagFilters.includes(lower));
  return match ? `/industries/${match.slug}` : null;
}

const { frontmatter, headings, rawContent } = Astro.props;
const {
  title,
  description,
  competitor,
  date,
  lastUpdated,
  tags = [],
  faqs = [],
  verdict,
  bestFor,
  bestForCompetitor,
} = frontmatter;

const readingTime = rawContent ? getReadingTime(rawContent()) : null;

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Comparisons", url: "/vs" },
  { name: title },
];

const compSchema = getComparisonSchema({
  title,
  description,
  url: Astro.url.href,
  date: date?.toISOString?.() || date,
  lastUpdated: lastUpdated?.toISOString?.() || lastUpdated,
  competitor,
});

const breadcrumbSchema = getBreadcrumbSchema(breadcrumbItems);
const jsonLD: any[] = [compSchema, breadcrumbSchema];
if (faqs.length > 0) jsonLD.push(getFAQSchema(faqs));

const aiSummaryMeta = verdict || description;

// Related reviews — score by tag overlap with this comparison, top 3
const allReviews = (await getCollection("reviews")).filter((r) => !r.data.draft);
const currentTagSet = new Set((tags || []).map((t: string) => t.toLowerCase()));
const relatedReviews = allReviews
  .map((r) => {
    const otherTags = new Set((r.data.tags || []).map((t: string) => t.toLowerCase()));
    let overlap = 0;
    for (const t of currentTagSet) if (otherTags.has(t)) overlap++;
    return { entry: r, overlap };
  })
  .filter((x) => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap || +new Date(b.entry.data.date) - +new Date(a.entry.data.date))
  .slice(0, 3);
---

<MainLayout
  title={title}
  description={description}
  jsonLD={jsonLD}
  ogType="article"
  publishedTime={date?.toISOString?.()}
  modifiedTime={lastUpdated?.toISOString?.() || date?.toISOString?.()}
>
  <meta slot="head" name="ai-summary" content={aiSummaryMeta} />
  <meta slot="head" name="ai-page-type" content="comparison" />
  <meta slot="head" name="ai-competitor" content={competitor} />

  <article
    class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12"
    data-page-type="comparison"
    data-competitor={competitor}
  >
    <Breadcrumbs items={breadcrumbItems} />

    <header class="mb-10 pb-8 border-b border-gray-100">
      <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-700 mb-4">
        Comparison &middot; SmarterOutbound vs {competitor}
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-3">{title}</h1>
      <p class="text-lg text-gray-600 leading-relaxed mb-5">{description}</p>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-500">
        {date && (
          <span>
            Published <time datetime={date.toISOString?.() || date}>{formatDate(date)}</time>
          </span>
        )}
        {lastUpdated && (
          <span>
            Updated <time datetime={lastUpdated.toISOString?.() || lastUpdated}>{formatDate(lastUpdated)}</time>
          </span>
        )}
        {readingTime && <span>{readingTime}</span>}
      </div>

      {tags.length > 0 && (
        <div class="flex gap-2 flex-wrap mt-4">
          {tags.map((tag: string) => {
            const url = industryUrlForTag(tag);
            return url ? (
              <a
                href={url}
                class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-50 text-primary-700 hover:bg-primary-100 transition-colors no-underline"
              >
                {tag}
              </a>
            ) : (
              <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
                {tag}
              </span>
            );
          })}
        </div>
      )}
    </header>

    <!-- Quick verdict block -->
    {(verdict || bestFor || bestForCompetitor) && (
      <div class="grid md:grid-cols-2 gap-4 mb-10">
        {bestFor && (
          <div class="bg-primary-50 border border-primary-200 rounded-xl p-5">
            <div class="text-xs uppercase tracking-wider font-bold text-primary-700 mb-1.5">SmarterOutbound is best for</div>
            <p class="text-sm text-gray-800 leading-relaxed">{bestFor}</p>
          </div>
        )}
        {bestForCompetitor && (
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-5">
            <div class="text-xs uppercase tracking-wider font-bold text-gray-600 mb-1.5">{competitor} is best for</div>
            <p class="text-sm text-gray-800 leading-relaxed">{bestForCompetitor}</p>
          </div>
        )}
        {verdict && (
          <div class="md:col-span-2 bg-gradient-to-r from-primary-50 to-accent-50 border border-primary-200 rounded-xl p-5">
            <div class="text-xs uppercase tracking-wider font-bold text-primary-800 mb-1.5">Verdict</div>
            <p class="text-sm text-gray-800 leading-relaxed">{verdict}</p>
          </div>
        )}
      </div>
    )}

    <!-- Body -->
    <div class="prose max-w-none">
      <slot />
    </div>

    <!-- FAQs (if any) -->
    {faqs.length > 0 && (
      <section class="mt-14 pt-10 border-t border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently asked</h2>
        <div class="faq-accordion">
          {faqs.map((faq: { question: string; answer: string }) => (
            <details>
              <summary>{faq.question}</summary>
              <div class="faq-answer">{faq.answer}</div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- Related reviews — internal linking from comparison to real client outcomes -->
    {relatedReviews.length > 0 && (
      <section class="mt-14 pt-10 border-t border-gray-100">
        <h2 class="text-2xl font-bold text-gray-900 mb-2">Real client outcomes that informed this comparison</h2>
        <p class="text-sm text-gray-500 mb-6">Reviews from clients who weighed the same trade-offs.</p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedReviews.map(({ entry }) => (
            <a
              href={`/reviews/${entry.id}`}
              class="group block bg-white border border-gray-200 rounded-xl p-5 hover:border-primary-300 hover:shadow-sm transition-all no-underline"
            >
              <div class="flex items-center justify-between mb-2">
                <StarRating rating={entry.data.rating} size="sm" showValue />
                <time class="text-xs text-gray-400" datetime={entry.data.date.toISOString()}>
                  {formatDate(entry.data.date)}
                </time>
              </div>
              <h3 class="text-sm font-bold text-gray-900 group-hover:text-primary-700 transition-colors leading-snug mb-1.5">
                {entry.data.title}
              </h3>
              <p class="text-xs text-gray-500 line-clamp-2 leading-relaxed">{entry.data.summary}</p>
              {entry.data.reviewer && (
                <div class="text-xs text-gray-400 mt-2">
                  {entry.data.reviewer}{entry.data.reviewerCompany && ` · ${entry.data.reviewerCompany}`}
                </div>
              )}
            </a>
          ))}
        </div>
        <div class="mt-4 flex flex-wrap gap-3 text-sm">
          <a href="/reviews" class="text-primary-600 hover:text-primary-700 font-semibold no-underline">All reviews →</a>
          <a href="/industries" class="text-primary-600 hover:text-primary-700 font-semibold no-underline">Browse by industry →</a>
          <a href="/data" class="text-primary-600 hover:text-primary-700 font-semibold no-underline">Aggregate data →</a>
        </div>
      </section>
    )}

    <CtaBlock variant="boxed" />
  </article>
</MainLayout>
