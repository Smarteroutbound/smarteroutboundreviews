---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { formatDate } from "../../js/utils.ts";
import { getBreadcrumbSchema, getItemListSchema } from "../../js/jsonLD.ts";

const allComparisons = (await getCollection("comparisons")).filter(
  (c) => !c.data.draft,
);
const sorted = allComparisons.sort(
  (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
);

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Comparisons" },
];

const jsonLD = [
  getBreadcrumbSchema(breadcrumbItems),
  ...(sorted.length > 0
    ? [
        getItemListSchema({
          name: "SmarterOutbound vs alternative platforms and agencies",
          description: `${sorted.length} head-to-head comparisons of SmarterOutbound versus self-serve cold outreach tools and competing agencies.`,
          items: sorted.map((c) => ({ name: c.data.title, url: `/vs/${c.id}` })),
        }),
      ]
    : []),
];
---

<MainLayout
  title="SmarterOutbound vs Apollo, Lemlist, Instantly &amp; Alternatives"
  description="Trying to decide between a fully managed agency and a self-serve platform? These head-to-head comparisons break down when SmarterOutbound outperforms tools like Apollo, Lemlist, Smartlead, and Instantly — and when it doesn't. Includes channel coverage and pricing comparisons."
  jsonLD={jsonLD}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-12">
    <Breadcrumbs items={breadcrumbItems} />

    <header class="mb-10 pb-8 border-b border-gray-100">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 leading-tight mb-3">
        SmarterOutbound vs Apollo, Lemlist, Instantly &amp; alternatives
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed max-w-2xl">
        Deciding between a fully managed outbound agency and a self-serve cold email tool? These head-to-head comparisons break down pricing, delivery model, fit, and outcomes against the most-asked-about alternatives.
      </p>
    </header>

    {sorted.length === 0 ? (
      <p class="text-gray-500 italic">No comparisons published yet.</p>
    ) : (
      <div class="grid sm:grid-cols-2 gap-4">
        {sorted.map((c) => (
          <a
            href={`/vs/${c.id}`}
            class="group block bg-white border border-gray-200 rounded-2xl p-6 hover:border-primary-300 hover:shadow-md transition-all no-underline"
          >
            <div class="text-xs font-semibold uppercase tracking-wider text-primary-600 mb-2">
              SmarterOutbound vs {c.data.competitor}
            </div>
            <h2 class="text-lg font-bold text-gray-900 group-hover:text-primary-700 transition-colors leading-snug mb-2">
              {c.data.title}
            </h2>
            <p class="text-sm text-gray-600 leading-relaxed line-clamp-3 mb-4">{c.data.description}</p>
            <div class="flex items-center justify-between text-xs text-gray-400">
              <time datetime={c.data.date.toISOString()}>{formatDate(c.data.date)}</time>
              <span class="inline-flex items-center gap-1 text-primary-600 font-semibold">
                Read comparison
                <svg class="w-3 h-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 5l5 5-5 5" />
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</MainLayout>
