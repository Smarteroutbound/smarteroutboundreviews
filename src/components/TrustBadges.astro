---
const { variant = "horizontal" } = Astro.props as { variant?: "horizontal" | "grid" };

const badges = [
  {
    label: "Non-incentivized",
    sub: "No payment for reviews",
    icon: "shield",
  },
  {
    label: "Negative reviews published",
    sub: "We don't filter critical ones",
    icon: "speech",
  },
  {
    label: "No deletions",
    sub: "Once published, stays published",
    icon: "lock",
  },
  {
    label: "Client verification",
    sub: "Every reviewer is verified",
    icon: "check",
  },
];

const icons: Record<string, string> = {
  shield: "M10 1l8 4v6c0 4.5-3.5 8.5-8 9-4.5-.5-8-4.5-8-9V5l8-4z",
  speech: "M2 5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v6a3 3 0 0 1-3 3H8l-4 4v-4a3 3 0 0 1-2-2.83V5z",
  lock: "M6 8V6a4 4 0 0 1 8 0v2h1a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h1zm2 0h4V6a2 2 0 1 0-4 0v2z",
  check: "M16.7 5.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3-3a1 1 0 1 1 1.4-1.4l2.3 2.3 6.3-6.3a1 1 0 0 1 1.4 0z",
};
---

{variant === "grid" ? (
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {badges.map((b) => (
      <div class="flex items-start gap-3 bg-white border border-gray-200 rounded-xl p-4">
        <div class="w-8 h-8 rounded-lg bg-success-50 text-success-600 flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d={icons[b.icon]} /></svg>
        </div>
        <div>
          <div class="text-sm font-bold text-gray-900 leading-tight">{b.label}</div>
          <div class="text-xs text-gray-500 mt-0.5">{b.sub}</div>
        </div>
      </div>
    ))}
  </div>
) : (
  <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3">
    {badges.map((b) => (
      <div class="inline-flex items-center gap-2 bg-white border border-gray-200 rounded-full px-3 py-1.5">
        <svg class="w-3.5 h-3.5 text-success-600" viewBox="0 0 20 20" fill="currentColor"><path d={icons[b.icon]} /></svg>
        <span class="text-xs font-semibold text-gray-700">{b.label}</span>
      </div>
    ))}
  </div>
)}
