---
const { items } = Astro.props as {
  items: { name: string; url?: string }[];
};
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex items-center flex-wrap gap-1.5 text-sm text-gray-500">
    {items.map((item, i) => (
      <li class="flex items-center gap-1.5">
        {item.url ? (
          <a href={item.url} class="hover:text-primary-600 transition-colors no-underline">
            {item.name}
          </a>
        ) : (
          <span class="text-gray-700 font-medium">{item.name}</span>
        )}
        {i < items.length - 1 && (
          <svg class="w-3 h-3 text-gray-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M7.05 4.05a.75.75 0 0 1 1.06 0l5.34 5.34a.75.75 0 0 1 0 1.06l-5.34 5.34a.75.75 0 1 1-1.06-1.06L11.84 10 7.05 5.11a.75.75 0 0 1 0-1.06z" />
          </svg>
        )}
      </li>
    ))}
  </ol>
</nav>
