---
import siteData from "../data/siteData.json";

const {
  title,
  description,
  image,
  robots,
  canonicalUrl,
  jsonLD,
  ogType = "website",
  publishedTime,
  modifiedTime,
} = Astro.props;

const pageTitle = title ? `${title} | ${siteData.title}` : siteData.title;
const pageDescription = description || siteData.description;
const canonical = canonicalUrl || Astro.url.href;

const OG_PREFIXES = ["reviews/", "vs/", "faq/"];

function resolveOgImage() {
  if (image) return typeof image === "string" ? image : image?.src;
  const pathname = Astro.url.pathname.replace(/\/$/, "").replace(/^\//, "");
  if (pathname && OG_PREFIXES.some((p) => pathname.startsWith(p))) {
    return `/og/${pathname}.png`;
  }
  return siteData.image?.src || "/images/og-default.png";
}

const pageImage = resolveOgImage();

// Compute Markdown alternate URL — every content/standalone page has a .md sibling at the same path + ".md"
// for AI crawlers. Skip pages with no .md endpoint defined.
const MD_PATH_PATTERNS: RegExp[] = [
  /^\/reviews\/[^/]+\/?$/,
  /^\/vs\/[^/]+\/?$/,
  /^\/industries\/[^/]+\/?$/,
  /^\/pricing\/?$/,
  /^\/data\/?$/,
  /^\/editorial-policy\/?$/,
  /^\/about\/?$/,
  /^\/faq\/?$/,
];

function resolveMarkdownAlt(): string | null {
  const path = Astro.url.pathname;
  if (!MD_PATH_PATTERNS.some((re) => re.test(path))) return null;
  // Strip trailing slash and add .md
  const clean = path.replace(/\/$/, "");
  return `${siteData.url}${clean}.md`;
}

const markdownAlt = resolveMarkdownAlt();
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<meta name="generator" content={Astro.generator} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}

{/* Markdown alternate for AI crawlers (ChatGPT, Claude, Perplexity, CCBot, GPTBot) */}
{markdownAlt && <link rel="alternate" type="text/markdown" href={markdownAlt} />}

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={siteData.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
{pageImage && <meta property="og:image" content={`${siteData.url}${pageImage}`} />}
{pageImage && <meta property="og:image:alt" content={image?.alt || pageTitle} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
{pageImage && <meta name="twitter:image" content={`${siteData.url}${pageImage}`} />}

{jsonLD && Array.isArray(jsonLD) ? (
  jsonLD.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))
) : jsonLD ? (
  <script type="application/ld+json" set:html={JSON.stringify(jsonLD)} />
) : null}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>
