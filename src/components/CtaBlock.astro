---
import siteData from "../data/siteData.json";

const { variant = "inline", heading, body, ctaLabel = "Visit SmarterOutbound", href: hrefProp, secondaryHref, secondaryLabel } = Astro.props as {
  variant?: "inline" | "boxed";
  heading?: string;
  body?: string;
  ctaLabel?: string;
  href?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
};

const defaultHeading = heading || `Considering ${siteData.parentSite.name}?`;
const defaultBody = body || "Skip the research. Get a personalized walkthrough and a custom outbound campaign quote — direct from the team.";
const href = hrefProp || siteData.parentSite.url;
const isExternal = href.startsWith("http");
---

{variant === "boxed" ? (
  <div class="mt-10 bg-gradient-to-br from-primary-600 to-primary-800 text-white rounded-2xl p-8 sm:p-10 shadow-lg">
    <h3 class="text-2xl font-bold mb-3">{defaultHeading}</h3>
    <p class="text-primary-50 mb-6 leading-relaxed">{defaultBody}</p>
    <div class="flex flex-wrap gap-3">
      <a
        href={href}
        class="inline-flex items-center gap-2 bg-accent-500 hover:bg-accent-600 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors no-underline"
        rel={isExternal ? "noopener" : undefined}
      >
        {ctaLabel}
        <svg class="w-4 h-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7 5l5 5-5 5" />
        </svg>
      </a>
      {secondaryHref && (
        <a
          href={secondaryHref}
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors no-underline"
          rel={secondaryHref.startsWith("http") ? "noopener" : undefined}
        >
          {secondaryLabel || "Learn more"}
        </a>
      )}
      {!secondaryHref && !hrefProp && (
        <a
          href={`${href}/#contact`}
          class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-5 py-2.5 rounded-lg transition-colors no-underline"
          rel="noopener"
        >
          Get a quote
        </a>
      )}
    </div>
  </div>
) : (
  <div class="mt-10 border-l-4 border-accent-500 bg-accent-50 rounded-r-xl p-6">
    <h3 class="text-lg font-bold text-gray-900 mb-2">{defaultHeading}</h3>
    <p class="text-gray-700 mb-4 text-sm leading-relaxed">{defaultBody}</p>
    <a
      href={href}
      class="inline-flex items-center gap-1.5 text-accent-700 hover:text-accent-600 font-semibold text-sm no-underline"
      rel={isExternal ? "noopener" : undefined}
    >
      {ctaLabel}
      <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7 5l5 5-5 5" />
      </svg>
    </a>
  </div>
)}
