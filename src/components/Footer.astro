---
import { footerSections } from "../data/navData.ts";
import siteData from "../data/siteData.json";

const currentYear = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-300 mt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <div class="flex items-center gap-2.5 mb-3">
          <div class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
              <path d="M3 10l4 4 10-10" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="font-bold text-white text-sm leading-tight">SmarterOutbound<br /><span class="text-primary-300">Reviews</span></span>
        </div>
        <p class="text-xs text-gray-400 leading-relaxed">
          Independent reviews and comparisons of SmarterOutbound, a fully managed B2B multi-channel outbound agency.
        </p>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-3">Explore</h4>
        <ul class="space-y-2">
          {footerSections.explore.map((item) => (
            <li>
              <a href={item.path} class="text-sm text-gray-400 hover:text-white transition-colors no-underline">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-3">Trust & Site</h4>
        <ul class="space-y-2">
          {footerSections.trust.map((item) => (
            <li>
              <a href={item.path} class="text-sm text-gray-400 hover:text-white transition-colors no-underline">
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-white font-semibold text-sm mb-3">SmarterOutbound</h4>
        <ul class="space-y-2">
          {footerSections.parent.map((item) => (
            <li>
              <a
                href={item.path}
                rel="noopener"
                class="text-sm text-gray-400 hover:text-accent-400 transition-colors no-underline inline-flex items-center gap-1"
              >
                {item.name}
                <svg class="w-3 h-3 opacity-60" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M11 3a1 1 0 1 0 0 2h2.59l-6.3 6.29a1 1 0 1 0 1.42 1.42L15 6.41V9a1 1 0 1 0 2 0V4a1 1 0 0 0-1-1h-5z" />
                  <path d="M5 5a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3a1 1 0 1 0-2 0v3H5V7h3a1 1 0 1 0 0-2H5z" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-gray-500">
      <span>&copy; {currentYear} {siteData.title}. All rights reserved.</span>
      <span class="max-w-xl text-right">
        Published by {siteData.parentSite.name}. Reviews reflect the views of their respective authors. We do not pay for, edit, or delete reviews — see our <a href="/editorial-policy" class="underline hover:text-white">editorial policy</a>.
      </span>
    </div>
  </div>
</footer>
